# 默认 local，无需密钥；复制为 .env 后需自行加载到环境变量。
AUDIT_MODE=local
AUDIT_DB_PATH=data/audit.sqlite3

# LLM 模式使用 OpenAI 兼容 Chat Completions function calling。
# AUDIT_MODE=llm
# AUDIT_LLM_API_KEY=
# AUDIT_LLM_BASE_URL=https://api.openai.com/v1
# AUDIT_LLM_MODEL=填写服务商支持工具调用的模型名

# 设置此项后才会把用户问题/案例摘要发送到 Mem0。
# MEM0_API_KEY=
# MEM0_BASE_URL=https://api.mem0.ai

# 非回环监听强制需要访问令牌；页面令牌框中填写相同值。
# AUDIT_API_TOKEN=
# AUDIT_USER_ID=demo-auditor
# AUDIT_ENTITY_IDS=C001,C002,C003
